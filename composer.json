{
  "name": "agendum/agendum-vtiger-adapter",
  "description": "An adapter to integrate Agendum with Vtiger CRM modules",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Francesco Bianco",
      "email": "bianco@javanile.org"
    }
  ],
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "files": [
      "src/aliases.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
